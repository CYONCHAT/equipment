NODE_ENV=production
SERVICE_NAME=operaon-equipment
PORT=4780
CORS_ORIGIN=https://app.example.com
TRUST_PROXY_HOPS=1

DB_HOST=postgres
DB_PORT=5432
DB_NAME=operaon_equipment
DB_USER=equipment_service
DB_PASSWORD=replace-in-deployment-secret
DB_SSL=false
DB_LOGGING=false

SERVICE_API_KEY=replace-with-service-key
JWT_ALGORITHM=HS256
JWT_SECRET=replace-with-identity-compatible-secret
JWT_PUBLIC_KEY=
JWT_ISSUER=operaon-identity
JWT_AUDIENCE=operaon-equipment

ENTITLEMENTS_SERVICE_URL=http://entitlements:4770
CATALOG_SERVICE_URL=http://catalog:4750
AGEND_SERVICE_URL=http://agend:4720
BILLING_SERVICE_URL=http://billing:4765
PAY_SERVICE_URL=http://pay:4601
INTEGRATION_MODE=live
INTEGRATION_SERVICE_KEY=replace-with-internal-service-key
INTEGRATION_TIMEOUT_MS=5000

RENTAL_MINIMUM_BILLING_MINUTES=15
RENTAL_OVERTIME_ROUNDING_MINUTES=15
RENTAL_CHECKIN_GRACE_MINUTES=15
RENTAL_MAX_OPEN_SESSION_HOURS=24

# ==================== OPERAON COMMUNICATION CONTRACT ====================
# Identidade não secreta do serviço. Segredos reais devem vir do secret manager.
SERVICE_NAME=operaon-equipment
COMMUNICATION_PROTOCOL_VERSION=1
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
INTERNAL_REQUEST_TIMEOUT_MS=5000
INTERNAL_RETRY_MAX_ATTEMPTS=3
COMMUNICATION_KEY_ID=service-key-v1
WEBHOOK_KEY_ID=webhook-key-v1
# Em produção, o ingress deve exigir X-Service-Id, X-Key-Id e mTLS.
REQUIRE_SERVICE_IDENTITY_HEADERS=true
REQUIRE_MTLS=true
TRUSTED_MTLS_HEADER=x-ssl-client-verify
